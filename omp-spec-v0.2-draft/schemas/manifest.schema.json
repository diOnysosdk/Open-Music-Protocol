{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.omp.example/v0.2/manifest.schema.json",
  "title": "OMP manifest v0.2",
  "$comment": "Normative semantic checks include typed identifiers, portable-path normalization, uniqueness, exactly one primary asset, and track/disc total relationships.",
  "type": "object",
  "required": [
    "schema_version", "manifest_id", "recording_id", "work_id", "issuer_id",
    "metadata", "assets", "agreement_id", "license_id", "created_at", "signature"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "manifest_id": { "$ref": "#/$defs/identifier" },
    "recording_id": { "$ref": "#/$defs/identifier" },
    "work_id": { "$ref": "#/$defs/identifier" },
    "release_id": { "$ref": "#/$defs/identifier" },
    "issuer_id": { "$ref": "#/$defs/identityReference" },
    "metadata": { "$ref": "metadata.schema.json" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/asset" }
    },
    "agreement_id": { "$ref": "#/$defs/identifier" },
    "license_id": { "$ref": "#/$defs/identifier" },
    "created_at": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "identityReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001F])[^/]+(?:/[^/]+)*$"
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id", "relative_path", "role", "selection_rank", "media_type",
        "sha256", "size_bytes"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "relative_path": { "$ref": "#/$defs/portablePath" },
        "role": { "enum": ["primary", "alternate", "preview"] },
        "selection_rank": { "type": "integer", "minimum": 0 },
        "media_type": {
          "enum": ["audio/flac", "audio/mpeg", "audio/ogg", "audio/wav", "audio/mp4"]
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      },
      "additionalProperties": false
    }
  }
}
