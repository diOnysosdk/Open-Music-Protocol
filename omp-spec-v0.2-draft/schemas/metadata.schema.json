{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.omp.example/v0.2/metadata.schema.json",
  "title": "OMP descriptive metadata v0.2 draft",
  "$comment": "Descriptive metadata is an authenticated issuer statement, not evidence of ownership or rights.",
  "type": "object",
  "required": ["title", "artist_credits", "contributors", "role_vocabulary"],
  "properties": {
    "title": { "$ref": "#/$defs/displayText" },
    "subtitle": { "$ref": "#/$defs/displayText" },
    "version_label": { "$ref": "#/$defs/displayText" },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "role_vocabulary": { "const": "omp-contributor-roles-v0.2" },
    "artist_credits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/artistCredit" }
    },
    "contributors": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/contributor" }
    },
    "release": { "$ref": "#/$defs/release" }
  },
  "additionalProperties": false,
  "$defs": {
    "displayText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": ".*\\S.*"
    },
    "identityReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "artistCredit": {
      "type": "object",
      "required": ["display_name"],
      "properties": {
        "display_name": { "$ref": "#/$defs/displayText" },
        "identity": { "$ref": "#/$defs/identityReference" },
        "join_phrase": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "contributor": {
      "type": "object",
      "required": ["credit_id", "display_name", "roles"],
      "properties": {
        "credit_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "display_name": { "$ref": "#/$defs/displayText" },
        "identity": { "$ref": "#/$defs/identityReference" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "primary_artist", "featured_artist", "performer", "vocalist",
              "instrumentalist", "composer", "lyricist", "producer",
              "engineer", "mixer", "mastering_engineer"
            ]
          }
        },
        "instrument": { "$ref": "#/$defs/displayText" }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["title", "release_type"],
      "properties": {
        "release_id": { "$ref": "#/$defs/identityReference" },
        "title": { "$ref": "#/$defs/displayText" },
        "release_type": {
          "enum": ["single", "ep", "album", "compilation", "mixtape", "soundtrack", "other"]
        },
        "release_date": {
          "type": "string",
          "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"
        },
        "label_name": { "$ref": "#/$defs/displayText" },
        "catalog_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "track_number": { "type": "integer", "minimum": 1 },
        "track_total": { "type": "integer", "minimum": 1 },
        "disc_number": { "type": "integer", "minimum": 1 },
        "disc_total": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
