{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.omp.example/v0.1/license.schema.json",
  "title": "OMP license v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "license_id",
    "recording_id",
    "subject_id",
    "mode",
    "offline",
    "valid_from",
    "issuer_id",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "license_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "recording_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "free",
        "purchase",
        "subscription"
      ]
    },
    "offline": {
      "type": "boolean"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
