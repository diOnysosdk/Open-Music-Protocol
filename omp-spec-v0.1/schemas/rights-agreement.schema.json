{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.omp.example/v0.1/rights-agreement.schema.json",
  "title": "OMP rights-agreement v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "agreement_id",
    "version",
    "recording_id",
    "effective_from",
    "currency",
    "allocation_pool",
    "splits",
    "issuer_id",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "agreement_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "recording_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "allocation_pool": {
      "enum": [
        "master_net_receipts",
        "composition_net_receipts"
      ]
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "party_id",
          "basis_points"
        ],
        "properties": {
          "party_id": {
            "type": "string",
            "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "basis_points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      }
    },
    "issuer_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
