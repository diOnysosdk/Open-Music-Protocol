{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.omp.example/v0.1/playback-receipt.schema.json",
  "title": "OMP playback-receipt v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "recording_id",
    "license_id",
    "agreement_id",
    "agreement_version",
    "installation_id",
    "session_id",
    "sequence",
    "previous_hash",
    "started_at",
    "duration_ms",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "recording_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "license_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "agreement_id": {
      "type": "string",
      "pattern": "^omp:(work|recording|release|party|license|agreement|manifest|receipt|settlement):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "agreement_version": {
      "type": "integer",
      "minimum": 1
    },
    "installation_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
